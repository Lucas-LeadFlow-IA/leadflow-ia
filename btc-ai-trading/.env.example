# =====================================================================
#  BTC AI TRADING — HYPERLIQUID — configuration example
#  Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
#  This file contains NO real secret.
# =====================================================================

# ---------------------------------------------------------------------
# Trading mode: paper (default) | testnet | live
#   paper   : real market data (read-only), simulated orders, nothing signed.
#   testnet : real signed orders on Hyperliquid TESTNET (fake funds).
#   live    : REAL MONEY on mainnet. Disabled unless ALL live gates below
#             are satisfied AND a human types the confirmation at startup.
# ---------------------------------------------------------------------
TRADING_MODE=paper

# Market-data source for PAPER mode: mainnet (real market) | testnet
PAPER_DATA_SOURCE=mainnet

# ---------------------------------------------------------------------
# Hyperliquid credentials (TESTNET / LIVE only — leave empty for paper)
# NEVER put your MAIN wallet private key here. Create a dedicated
# API wallet (agent) at https://app.hyperliquid.xyz/API (or the testnet
# equivalent) — it can trade but CANNOT withdraw funds.
# ---------------------------------------------------------------------
# Public address of your MAIN account (used for read queries; not secret)
HL_ACCOUNT_ADDRESS=
# Private key of the dedicated API wallet (agent) — secret
HL_API_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------
# LIVE gates (all required for TRADING_MODE=live)
# ---------------------------------------------------------------------
# Must be exactly: I ACCEPT REAL MONEY RISK ON HYPERLIQUID MAINNET
LIVE_TRADING_CONFIRMATION=
# Set to true only after you verified legal eligibility in your country
# and Hyperliquid's terms of use (age, jurisdiction, restrictions).
LIVE_ELIGIBILITY_ACKNOWLEDGED=false

# ---------------------------------------------------------------------
# Risk (cannot exceed hard ceilings coded in risk/limits.py)
# ---------------------------------------------------------------------
INITIAL_CAPITAL_USD=1000
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_DRAWDOWN_PCT=8.0
MAX_LEVERAGE=1
MARGIN_MODE=isolated
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES_AFTER_LOSSES=120
# What the kill switch does with an open position: flatten | protect
EMERGENCY_POSITION_POLICY=flatten

# ---------------------------------------------------------------------
# Costs (Hyperliquid perps base tier — see docs/trading/fees)
# ---------------------------------------------------------------------
TAKER_FEE_RATE=0.00045
MAKER_FEE_RATE=0.00015
SLIPPAGE_BPS_MARKET=2.0
SLIPPAGE_BPS_STOP=5.0

# ---------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------
DECISION_INTERVAL_SECONDS=15
MAX_DATA_STALENESS_SECONDS=90
# Strategies allowed to trade (comma separated)
ENABLED_STRATEGIES=scalping,intraday,trend_following,range_trading
MIN_SETUP_SCORE=60

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# SQLite by default; PostgreSQL in docker-compose, e.g.
# DATABASE_URL=postgresql+psycopg://btc:btc@postgres:5432/btc_trading
DATABASE_URL=sqlite:///./data/trading.db
DATA_DIR=./data
RUNTIME_DIR=./runtime
MODELS_DIR=./models

# ---------------------------------------------------------------------
# Dashboard API
# ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Long random string required by the dashboard (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
DASHBOARD_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------
# Telegram (optional)
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user ids allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
